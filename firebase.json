{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "README.md", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(wasm|mjs|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "models/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
